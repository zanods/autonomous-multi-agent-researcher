# Copy to .env and fill in. Never commit the real .env.

# --- LLM provider: set ONE ---
# Google: generous free tier via AI Studio (no billing) — if it asks for
# billing, use Groq instead.
GOOGLE_API_KEY=
# Groq: free tier, no card required — https://console.groq.com
GROQ_API_KEY=
# River AI: $25 free credits for new users, no card, OpenAI-compatible — https://console.river.ai
RIVER_API_KEY=
# Optional: override the River model (see https://docs.river.ai for model IDs)
# RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Cerebras: free tier, no card, OpenAI-compatible — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter: free :free models, no card — https://openrouter.ai
OPENROUTER_API_KEY=
# Optional: override the OpenRouter model (must be a :free slug for $0)
# OPENROUTER_MODEL=cohere/north-mini-code:free
OPENAI_API_KEY=
MODEL=gemini-3.8-flash

# --- Embeddings (optional override; each provider has a working default) ---
# EMBEDDING_MODEL=

# --- Tools / infra ---
TAVILY_API_KEY=
COHERE_API_KEY=
CHROMA_DIR=./chroma_db
DB_PATH=./research.db
OPTIMIZE_TOKENS=1
